generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model achievements {
  id               BigInt   @id @default(autoincrement())
  user_id          String   @db.Uuid
  achievement_name String
  unlocked_at      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  profiles         profiles @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, achievement_name])
}

model collections {
  id         BigInt   @id @default(autoincrement())
  user_id    String   @db.Uuid
  item_id    String
  item_type  String
  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  profiles   profiles @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, item_id, item_type])
}

model friends {
  id                                   BigInt   @id @default(autoincrement())
  user_id                              String   @db.Uuid
  friend_id                            String   @db.Uuid
  status                               String   @default("pending")
  created_at                           DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  profiles_friends_friend_idToprofiles profiles @relation("friends_friend_idToprofiles", fields: [friend_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_friends_user_idToprofiles   profiles @relation("friends_user_idToprofiles", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, friend_id])
}

model messages {
  id                                      BigInt   @id @default(autoincrement())
  sender_id                               String   @db.Uuid
  receiver_id                             String   @db.Uuid
  content                                 String
  created_at                              DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  profiles_messages_receiver_idToprofiles profiles @relation("messages_receiver_idToprofiles", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_messages_sender_idToprofiles   profiles @relation("messages_sender_idToprofiles", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model profiles {
  id                                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                   String         @unique
  password_hash                           String
  username                                String         @unique
  avatar_url                              String?
  bio                                     String?
  favorite_genres                         String[]
  xp                                      Int?           @default(0)
  level                                   Int?           @default(1)
  total_spins                             Int?           @default(0)
  total_searches                          Int?           @default(0)
  push_token                              String?
  timezone                                String?
  last_active_at                          DateTime?      @db.Timestamptz(6)
  active_title_id                         String?
  role                                    String?        @default("user")
  title                                   String?        @default("Новичок")
  created_at                              DateTime       @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  achievements                            achievements[]
  collections                             collections[]
  friends_friends_friend_idToprofiles     friends[]      @relation("friends_friend_idToprofiles")
  friends_friends_user_idToprofiles       friends[]      @relation("friends_user_idToprofiles")
  messages_messages_receiver_idToprofiles messages[]     @relation("messages_receiver_idToprofiles")
  messages_messages_sender_idToprofiles   messages[]     @relation("messages_sender_idToprofiles")
  reviews                                 reviews[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id          BigInt   @id @default(autoincrement())
  user_id     String   @db.Uuid
  item_id     String
  item_type   String
  item_title  String
  item_artist String?
  item_cover  String?
  rating      Int?
  content     String
  created_at  DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  profiles    profiles @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
