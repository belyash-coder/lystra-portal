generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WatchStatus {
  PLANNED
  WATCHING
  WATCHED
}

enum MediaType {
  MOVIE
  TV
}

model Profile {
  id         String   @id @default(uuid())
  telegramId BigInt   @unique
  username   String?
  firstName  String?
  lastName   String?
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  addedMovies  Movie[]       @relation("MovieAddedBy")
  watchEntries WatchEntry[]
  lists        MovieList[]

  createdSharedLists    SharedList[]       @relation("SharedListCreatedBy")
  sharedListMemberships SharedListMember[]
  addedSharedEntries    SharedListEntry[]  @relation("SharedListEntryAddedBy")
}

model Movie {
  id               String    @id @default(uuid())
  mediaType        MediaType @default(MOVIE)
  tmdbId           Int
  title            String
  originalTitle    String?
  posterPath       String?
  overview         String?
  releaseYear      Int?
  runtime          Int?
  numberOfSeasons  Int?
  numberOfEpisodes Int?
  tmdbRating       Float?
  genres           String[]
  addedById        String
  addedBy          Profile   @relation("MovieAddedBy", fields: [addedById], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())

  watchEntries      WatchEntry[]
  listEntries       MovieListEntry[]
  sharedListEntries SharedListEntry[]

  @@unique([tmdbId, mediaType])
  @@index([addedById])
}

model WatchEntry {
  id        String      @id @default(uuid())
  profileId String
  movieId   String
  status    WatchStatus @default(PLANNED)
  rating    Int?
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movie   Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([profileId, movieId])
  @@index([movieId])
}

model MovieList {
  id        String   @id @default(uuid())
  profileId String
  name      String
  createdAt DateTime @default(now())

  profile Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  entries MovieListEntry[]

  @@unique([profileId, name])
}

model MovieListEntry {
  listId  String
  movieId String
  addedAt DateTime @default(now())

  list  MovieList @relation(fields: [listId], references: [id], onDelete: Cascade)
  movie Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([listId, movieId])
  @@index([movieId])
}

// Совместный список для просмотра вдвоём — не связан с личной библиотекой
// и личными списками; отметка "просмотрено" одна на весь список.
model SharedList {
  id          String   @id @default(uuid())
  createdById String
  createdAt   DateTime @default(now())

  createdBy Profile            @relation("SharedListCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  members   SharedListMember[]
  entries   SharedListEntry[]
}

model SharedListMember {
  sharedListId String
  profileId    String
  joinedAt     DateTime @default(now())

  sharedList SharedList @relation(fields: [sharedListId], references: [id], onDelete: Cascade)
  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([sharedListId, profileId])
  @@index([profileId])
}

model SharedListEntry {
  sharedListId String
  movieId      String
  watched      Boolean   @default(false)
  watchedAt    DateTime?
  addedById    String
  addedAt      DateTime  @default(now())

  sharedList SharedList @relation(fields: [sharedListId], references: [id], onDelete: Cascade)
  movie      Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  addedBy    Profile    @relation("SharedListEntryAddedBy", fields: [addedById], references: [id], onDelete: Cascade)

  @@id([sharedListId, movieId])
  @@index([movieId])
}
