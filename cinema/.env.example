# Postgres — можно использовать новую базу в уже существующем Postgres-сервисе Coolify
DATABASE_URL="postgresql://user:password@host:5432/cinema"

# Любая случайная строка для подписи JWT-сессий (сгенерировать: openssl rand -base64 32)
AUTH_SECRET="change-me"

# Токен бота из @BotFather (используется только на сервере для проверки Telegram initData)
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."

# Ключ TMDB API (v3), получить на https://www.themoviedb.org/settings/api
TMDB_API_KEY="your-tmdb-api-key"

# Необязательно, но нужны для "честного" рандомайзера (проверка рейтинга по IMDb/КП,
# а не только по TMDB). Без них рандомайзер просто не будет фильтровать по рейтингу
# внешних источников — остальное работает и без них.
OMDB_API_KEY="your-omdb-api-key"
KINOPOISK_API_KEY="your-kinopoisk-dev-api-key"
